@page
@model AdminPersonal.Pages.Empleados.ContratarEmpleadoModel
@{
    ViewData["Title"] = "Contratar Empleado";
}

<div class="container mt-4">
    <h2>Contratar Empleado</h2>
    <hr />

    @if (!string.IsNullOrEmpty(Model.MensajeExito) || !string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="modal fade show" style="display:block;" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(!string.IsNullOrEmpty(Model.MensajeError) ? "Error" : "Mensaje")</h5>
                    </div>
                    <div class="modal-body">
                        <p>@(Model.MensajeError ?? Model.MensajeExito)</p>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-primary" asp-page="/Empleados/ContratarEmpleado">Aceptar</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Oferente</label>
            <select name="IdOferenteSeleccionado" class="form-control" required>
                <option value="0">-- Seleccione un oferente --</option>
                @foreach (var o in Model.Oferentes)
                {
                    <option value="@o.id_oferente">@o.NombreCompleto — @o.Identificacion</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Puesto</label>
            <select name="IdPuestoSeleccionado" class="form-control" required>
                <option value="0">-- Seleccione un puesto --</option>
                @foreach (var p in Model.Puestos)
                {
                    <option value="@p.IdPuesto">@p.Codigo — @p.Nombre (₡@p.Salario.ToString("N2"))</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a href="/" class="btn btn-secondary">Volver</a>
    </form>
</div>