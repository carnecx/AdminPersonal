@page
@model AdminPersonal.Pages.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<h2 class="mb-3">Editar Usuario</h2>

<a href="/Usuarios" class="btn btn-secondary mb-3">← Volver</a>

<form method="post">
    <input type="hidden" asp-for="Usuario.IdUsuario" />

    <div class="mb-3">
        <label class="form-label">Nombre de usuario</label>
        <input asp-for="Usuario.NombreUsuario" class="form-control" />
        <span asp-validation-for="Usuario.NombreUsuario" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre completo</label>
        <input asp-for="Usuario.NombreCompleto" class="form-control" />
        <span asp-validation-for="Usuario.NombreCompleto" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Correo</label>
        <input asp-for="Usuario.Correo" class="form-control" type="email" />
        <span asp-validation-for="Usuario.Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input asp-for="Usuario.Contrasena" class="form-control" type="password" placeholder="Dejar en blanco para mantener la actual" />
        <span asp-validation-for="Usuario.Contrasena" class="text-danger"></span>
        <div class="form-text">Deje este campo vacío si no desea cambiar la contraseña.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Estado</label>
        <select asp-for="Usuario.Estado" class="form-select">
            <option value="Activo">Activo</option>
            <option value="Inactivo">Inactivo</option>
            <option value="Bloqueado">Bloqueado</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Roles</label>
        @foreach (var rol in Model.Roles)
        {
            if (Model.Usuario.RolesSeleccionados.Contains(rol.id_rol))
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked
                           name="Usuario.RolesSeleccionados"
                           value="@rol.id_rol"
                           id="rol_@rol.id_rol" />
                    <label class="form-check-label" for="rol_@rol.id_rol">
                        @rol.nombre_rol
                    </label>
                </div>
            }
            else
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="Usuario.RolesSeleccionados"
                           value="@rol.id_rol"
                           id="rol_@rol.id_rol" />
                    <label class="form-check-label" for="rol_@rol.id_rol">
                        @rol.nombre_rol
                    </label>
                </div>
            }
        }
        <span asp-validation-for="Usuario.RolesSeleccionados" class="text-danger"></span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="/Usuarios" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
