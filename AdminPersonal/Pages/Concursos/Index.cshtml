@page
@model AdminPersonal.Pages.Concursos.IndexModel
@{
    ViewData["Title"] = "Concursos";
}

@if (TempData["Exito"] != null || TempData["Error"] != null)
{
    <div class="modal fade show" style="display:block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(TempData["Error"] != null ? "Error" : "Mensaje")</h5>
                </div>
                <div class="modal-body">
                    <p>@(TempData["Error"] ?? TempData["Exito"])</p>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-primary" asp-page="/Concursos/Index">Aceptar</a>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<h2 class="mb-3">Administración de Concursos</h2>
<a asp-page="Crear" class="btn btn-primary mb-3">+ Nuevo Concurso</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Concursos)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nombre</td>
                <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                <td>
                    <span class="badge @(item.Estado == "Vigente" ? "bg-success" : "bg-secondary")">
                        @item.Estado
                    </span>
                </td>
                <td>
                    <a asp-page="Editar" asp-route-id="@item.id_concurso" class="btn btn-warning btn-sm">Editar</a>
                    <form asp-page="CambiarEstado" asp-route-id="@item.id_concurso" method="post" class="d-inline">
                        <button type="submit" class="btn btn-secondary btn-sm">
                            @(item.Estado == "Vigente" ? "Marcar Vencido" : "Marcar Vigente")
                        </button>
                    </form>
                    <button class="btn btn-danger btn-sm" onclick="confirmarEliminar(@item.id_concurso)">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal confirmación eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mensaje</h5>
            </div>
            <div class="modal-body">
                <p>¿Realmente desea eliminar el elemento seleccionado?</p>
            </div>
            <div class="modal-footer">
                <form method="post" id="formEliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
                <button class="btn btn-secondary" data-bs-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminar(id) {
            document.getElementById('idEliminar').value = id;
            document.getElementById('formEliminar').action = '/Concursos/Eliminar/' + id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }
    </script>
}